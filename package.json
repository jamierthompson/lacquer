{
  "name": "lacquer",
  "version": "0.1.0",
  "description": "AI-native design system. The finishing school for AI-generated UI.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "dev": "pnpm --filter @lacquer/site dev",
    "start": "pnpm --filter @lacquer/site start",
    "mcp": "pnpm --filter @lacquer/mcp start",
    "lint": "biome check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @lacquer/site test:e2e",
    "gate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
