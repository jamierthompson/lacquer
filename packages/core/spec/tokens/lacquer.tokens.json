      "$value": {
        "value": 1.8,
        "unit": "s"
      }
    },
    "highlight": {
      "$description": "The bright point of the shimmer sweep; an alias of a foreground role.",
      "$extensions": {
        "dev.lacquer": {
          "tailwind": {
            "class": "via-lq-shimmer-highlight"
          }
        }
      },
      "$value": "{color.fg.default}"
    }
  }
}
