{
  "$description": "Lacquer's token roles and their reference values (light). DTCG Format Module 2025.10. A spec consumes a role by its path, color.bg.primary; bindings derive every property and class name from the path and the type.",
  "color": {
    "$type": "color",
    "$description": "Backgrounds, foregrounds, borders and status colours. Roles, never a palette. Written by hand in OKLCH; a role that carries text or a boundary declares the pairings it must clear in $extensions[\"dev.lacquer\"].contrast and the build measures them.",
    "bg": {
      "surface": {
        "$description": "The page.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.99, 0.003, 55],
          "hex": "#fdfbfa"
        }
      },
      "surface-secondary": {
        "$description": "A card or panel on the page.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.975, 0.004, 55],
          "hex": "#f9f6f4"
        }
      },
      "surface-tertiary": {
        "$description": "A well inside a panel: code, a quoted block.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.955, 0.005, 55],
          "hex": "#f3efed"
        }
      },
      "primary": {
        "$description": "The one primary action in a view.",
        "$extensions": {
          "dev.lacquer": {
            "contrast": [
              {
                "on": "color.bg.surface",
                "min": 3
              },
              {
                "on": "color.bg.surface-secondary",
                "min": 3
              },
              {
                "on": "color.bg.surface-tertiary",
                "min": 3
              }
            ]
          }
        },
        "$value": {
          "colorSpace": "oklch",
          "components": [0.24, 0.012, 55],
          "hex": "#241e1a"
        }
      },
      "primary-hover": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.31, 0.012, 55],
          "hex": "#352f2b"
        }
      },
      "secondary": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.95, 0.007, 55],
          "hex": "#f2edea"
        }
      },
      "secondary-hover": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.915, 0.008, 55],
          "hex": "#e7e2de"
        }
      },
      "accent": {
        "$description": "The hover wash on a quiet control: the brand at a whisper.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.955, 0.02, 195],
          "hex": "#e2f5f4"
        }
      },
      "destructive": {
        "$description": "A destructive action's fill; `status.error` and `border.danger` alias it.",
        "$extensions": {
          "dev.lacquer": {
            "contrast": [
              {
                "on": "color.fg.on-destructive",
                "min": 4.5
              },
              {
                "on": "color.bg.surface",
                "min": 3
              },
              {
                "on": "color.bg.surface-secondary",
                "min": 3
              },
              {
                "on": "color.bg.surface-tertiary",
                "min": 3
              }
            ]
          }
        },
        "$value": {
          "colorSpace": "oklch",
          "components": [0.56, 0.2, 27],
          "hex": "#d02c2a"
        }
      },
      "destructive-hover": {
        "$extensions": {
          "dev.lacquer": {
            "contrast": [
              {
                "on": "color.fg.on-destructive",
                "min": 4.5
              }
            ]
          }
        },
        "$value": {
          "colorSpace": "oklch",
          "components": [0.5, 0.2, 27],
          "hex": "#bb0916"
        }
      },
      "selected": {
        "$description": "A pressed toggle, a chosen row.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.92, 0.03, 195],
          "hex": "#cfebeb"
        }
      },
      "scrim": {
        "$description": "Behind a modal.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0.5
        }
      }
    },
    "fg": {
      "default": {
        "$description": "Body text on every neutral ground.",
        "$extensions": {
          "dev.lacquer": {
            "contrast": [
              {
                "on": "color.bg.surface",
                "min": 4.5
              },
              {
                "on": "color.bg.surface-secondary",
                "min": 4.5
              },
              {
                "on": "color.bg.surface-tertiary",
                "min": 4.5
              },
              {
                "on": "color.bg.secondary",
                "min": 4.5
              },
              {
                "on": "color.bg.secondary-hover",
                "min": 4.5
              },
              {
                "on": "color.bg.accent",
                "min": 4.5
              },
              {
                "on": "color.bg.selected",
                "min": 4.5
              }
            ]
          }
        },
        "$value": {
          "colorSpace": "oklch",
          "components": [0.2, 0.012, 55],
          "hex": "#1a1511"
        }
      },
      "muted": {
        "$description": "Secondary text; still readable on the deepest well.",
        "$extensions": {
          "dev.lacquer": {
            "contrast": [
              {
                "on": "color.bg.surface",
                "min": 4.5
              },
              {
                "on": "color.bg.surface-secondary",
                "min": 4.5
              },
              {
                "on": "color.bg.surface-tertiary",
                "min": 4.5
              },
              {
                "on": "color.bg.secondary",
                "min": 4.5
              },
              {
                "on": "color.bg.secondary-hover",
                "min": 4.5
              },
              {
                "on": "color.bg.accent",
                "min": 4.5
              },
              {
                "on": "color.bg.selected",
                "min": 4.5
              }
            ]
          }
        },
        "$value": {
          "colorSpace": "oklch",
          "components": [0.508, 0.015, 55],
          "hex": "#6d635e"
        }
      },
      "on-primary": {
        "$extensions": {
          "dev.lacquer": {
            "contrast": [
              {
                "on": "color.bg.primary",
                "min": 4.5
              },
              {
                "on": "color.bg.primary-hover",
                "min": 4.5
              }
            ]
          }
        },
        "$value": {
          "colorSpace": "oklch",
          "components": [0.985, 0.004, 55],
          "hex": "#fcf9f8"
        }
      },
      "on-secondary": {
        "$extensions": {
          "dev.lacquer": {
            "contrast": [
              {
                "on": "color.bg.secondary",
                "min": 4.5
              },
              {
                "on": "color.bg.secondary-hover",
                "min": 4.5
              }
            ]
          }
        },
        "$value": {
          "colorSpace": "oklch",
          "components": [0.2, 0.012, 55],
          "hex": "#1a1511"
        }
      },
      "on-destructive": {
        "$description": "White on the destructive fill.",
        "$value": {
          "colorSpace": "oklch",
          "components": [1, 0, 0],
          "hex": "#ffffff"
        }
      },
      "link": {
        "$description": "Links are the brand color.",
        "$value": "{color.accent.brand}"
      }
    },
    "border": {
      "default": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.9, 0.008, 55],
          "hex": "#e2ddd9"
        }
      },
      "subtle": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.94, 0.006, 55],
          "hex": "#eeeae7"
        }
      },
      "input": {
        "$description": "An input's boundary; 3:1 against the page (WCAG 1.4.11).",
        "$extensions": {
          "dev.lacquer": {
            "contrast": [
              {
                "on": "color.bg.surface",
                "min": 3
              },
              {
                "on": "color.bg.surface-secondary",
                "min": 3
              },
              {
                "on": "color.bg.surface-tertiary",
                "min": 3
              }
            ]
          }
        },
        "$value": {
          "colorSpace": "oklch",
          "components": [0.636, 0.012, 55],
          "hex": "#918984"
        }
      },
      "focus": {
        "$description": "The focus ring: the brand color, 3:1 on every surface.",
        "$extensions": {
          "dev.lacquer": {
            "tailwind": {
              "class": "outline-lq-border-focus"
            }
          }
        },
        "$value": "{color.accent.brand}"
      },
      "danger": {
        "$value": "{color.bg.destructive}"
      }
    },
    "status": {
      "pending": {
        "$description": "Not started yet: the muted text color.",
        "$value": "{color.fg.muted}"
      },
      "running": {
        "$extensions": {
          "dev.lacquer": {
            "contrast": [
              {
                "on": "color.bg.surface",
                "min": 4.5
              },
              {
                "on": "color.bg.surface-secondary",
                "min": 4.5
              },
              {
                "on": "color.bg.surface-tertiary",
                "min": 4.5
              }
            ]
          }
        },
        "$value": {
          "colorSpace": "oklch",
          "components": [0.539, 0.17, 255],
          "hex": "#0f6cce"
        }
      },
      "success": {
        "$extensions": {
          "dev.lacquer": {
            "contrast": [
              {
                "on": "color.bg.surface",
                "min": 4.5
              },
              {
                "on": "color.bg.surface-secondary",
                "min": 4.5
              },
              {
                "on": "color.bg.surface-tertiary",
                "min": 4.5
              }
            ]
          }
        },
        "$value": {
          "colorSpace": "oklch",
          "components": [0.518, 0.142, 150],
          "hex": "#027e38"
        }
      },
      "error": {
        "$value": "{color.bg.destructive}"
      },
      "warning": {
        "$extensions": {
          "dev.lacquer": {
            "contrast": [
              {
                "on": "color.bg.surface",
                "min": 4.5
              },
              {
                "on": "color.bg.surface-secondary",
                "min": 4.5
              },
              {
                "on": "color.bg.surface-tertiary",
                "min": 4.5
              }
            ]
          }
        },
        "$value": {
          "colorSpace": "oklch",
          "components": [0.542, 0.116, 72],
          "hex": "#986200"
        }
      }
    },
    "accent": {
      "brand": {
        "$description": "The one chromatic brand color. Links, the focus ring, and the AI accent alias it.",
        "$extensions": {
          "dev.lacquer": {
            "contrast": [
              {
                "on": "color.bg.surface",
                "min": 4.5
              },
              {
                "on": "color.bg.surface-secondary",
                "min": 4.5
              },
              {
                "on": "color.bg.surface-tertiary",
                "min": 4.5
              },
              {
                "on": "color.bg.surface",
                "min": 3
              },
              {
                "on": "color.bg.surface-secondary",
                "min": 3
              },
              {
                "on": "color.bg.surface-tertiary",
                "min": 3
              }
            ]
          }
        },
        "$value": {
          "colorSpace": "oklch",
          "components": [0.515, 0.087, 195],
          "hex": "#047777"
        }
      },
      "ai": {
        "$description": "The AI accent. An alias of a brand token, never a new hue (LQ-STYLE-01).",
        "$value": "{color.accent.brand}"
      }
    }
  },
