  "motion": {
    "$type": "duration",
    "$description": "Durations and the standard easing.",
    "duration": {
      "fast": {
        "$value": {
          "value": 100,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "spin": {
        "$description": "One revolution of a spinner.",
        "$extensions": {
          "dev.lacquer": {
            "tailwind": {
              "namespace": null,
              "property": "animation-duration"
            }
          }
        },
        "$value": {
          "value": 1,
          "unit": "s"
        }
      },
      "pulse": {
        "$description": "One cycle of a pending pulse.",
        "$extensions": {
          "dev.lacquer": {
            "tailwind": {
              "namespace": null,
              "property": "animation-duration"
            }
          }
        },
        "$value": {
          "value": 2,
          "unit": "s"
        }
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [0, 0, 0.2, 1]
      }
    }
