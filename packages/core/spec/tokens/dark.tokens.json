{
  "$description": "Dark overrides for the reference theme. Only roles whose value changes; everything else resolves from lacquer.tokens.json.",
  "color": {
    "$type": "color",
    "bg": {
      "surface": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.17, 0.008, 55],
          "hex": "#120f0c"
        }
      },
      "surface-secondary": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.21, 0.008, 55],
          "hex": "#1b1715"
        }
      },
      "surface-tertiary": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.25, 0.009, 55],
          "hex": "#25211e"
        }
      },
      "primary": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.95, 0.006, 55],
          "hex": "#f2edeb"
        }
      },
      "primary-hover": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.88, 0.006, 55],
          "hex": "#dbd6d4"
        }
      },
      "secondary": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.28, 0.01, 55],
          "hex": "#2d2824"
        }
      },
      "secondary-hover": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.33, 0.01, 55],
          "hex": "#3a3431"
        }
      },
      "accent": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.29, 0.035, 195],
          "hex": "#143131"
        }
      },
      "destructive": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.56, 0.19, 27],
          "hex": "#cc3430"
        }
      },
      "destructive-hover": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.59, 0.19, 27],
          "hex": "#d73f39"
        }
      },
      "selected": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.34, 0.045, 195],
          "hex": "#173f3f"
        }
      }
    },
    "fg": {
      "default": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.96, 0.005, 55],
          "hex": "#f5f1ef"
        }
      },
      "muted": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.72, 0.012, 55],
          "hex": "#aba39e"
        }
      },
      "on-primary": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.2, 0.012, 55],
          "hex": "#1a1511"
        }
      },
      "on-secondary": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.96, 0.005, 55],
          "hex": "#f5f1ef"
        }
      },
      "on-destructive": {
        "$value": {
          "colorSpace": "oklch",
          "components": [1, 0, 0],
          "hex": "#ffffff"
        }
      }
    },
    "border": {
      "default": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.3, 0.01, 55],
          "hex": "#322d29"
        }
      },
      "subtle": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.26, 0.009, 55],
          "hex": "#282320"
        }
      },
      "input": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.528, 0.012, 55],
          "hex": "#716a65"
        }
      }
    },
    "status": {
      "running": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.75, 0.13, 255],
          "hex": "#73b1ff"
        }
      },
      "success": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.78, 0.15, 150],
          "hex": "#67d283"
        }
      },
      "warning": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.82, 0.149, 72],
          "hex": "#ffb346"
        }
      }
    },
    "accent": {
      "brand": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.76, 0.11, 195],
          "hex": "#47c7c7"
        }
      }
    }
  }
}
