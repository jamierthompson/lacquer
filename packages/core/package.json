{
  "name": "@lacquer/core",
  "version": "0.1.0",
  "description": "The Lacquer catalog: schema, vocabulary, rules, bindings and every component spec, compiled to JSON.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog.json": "./dist/catalog.json",
    "./index.json": "./dist/index.json",
    "./rules.json": "./dist/rules.json",
    "./components/*.json": "./dist/components/*.json",
    "./bindings/*": "./spec/bindings/*",
    "./catalog/*": "./spec/catalog/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-spec.ts && tsc -p tsconfig.json",
    "check": "node scripts/build-spec.ts --check && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "yaml": "^2.8.1"
  }
}
