{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lacquer.dev/schema/report.schema.json",
  "title": "Lacquer finish report",
  "description": "The output of lacquer_lint and lacquer_grade. One report per screen or component. Every finding cites a rule id from spec/dist/rules.json; scores follow grading/rubric.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "subject", "detected", "score", "findings"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "mode": { "type": "string", "enum": ["static", "runtime"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["source", "dom", "url"] },
        "language": { "type": "string" },
        "url": { "type": "string" },
        "binding": { "type": "string" },
        "hash": { "type": "string", "description": "Content hash so reports can be compared across runs." }
      }
    },
    "detected": {
      "type": "array",
      "description": "Catalog components the grader believes are present.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "instances", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "instances": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "how": { "type": "string", "description": "data-slot | aria | heuristic | name" }
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "letter", "dimensions"],
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 100 },
        "letter": { "type": "string", "enum": ["A", "B", "C", "D", "F"] },
        "capped": { "type": "boolean", "description": "True when a MUST in structure/accessibility capped the letter." },
        "dimensions": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule", "level", "dimension", "component", "message"],
        "properties": {
          "id": { "type": "string", "description": "Stable per report: <rule>#<n>." },
          "rule": { "type": "string", "pattern": "^LQ-[A-Z0-9]+-\\d{2}$" },
          "level": { "type": "string", "enum": ["MUST", "SHOULD", "MAY"] },
          "dimension": { "type": "string" },
          "component": { "type": "string", "description": "Catalog id, or 'screen' for universal findings." },
          "message": { "type": "string", "description": "The rule statement, made specific to this instance." },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "column": { "type": "integer" },
              "selector": { "type": "string" },
              "snippet": { "type": "string" }
            }
          },
          "evidence": { "type": "string", "description": "What the detector saw." },
          "fix": { "type": "string" },
          "instances": { "type": "integer", "minimum": 1 },
          "reference": { "type": "string", "description": "Path to the catalog's reference implementation or example that does it right." }
        }
      }
    },
    "summary": { "type": "string", "description": "Two or three sentences for a human: worst thing first, then what passes." }
  }
}
